# PostHog (Project settings -> Project API key). Safe to expose in the client.
# Add these in Netlify: Site configuration -> Environment variables.
VITE_PUBLIC_POSTHOG_KEY=phc_your_project_api_key

# EU Cloud users should set https://eu.i.posthog.com
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Set automatically by netlify.toml per deploy context. Leave unset locally.
# VITE_CONTEXT=production
